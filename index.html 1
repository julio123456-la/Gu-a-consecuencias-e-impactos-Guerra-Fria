<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Docs - Documento sin título</title>
    <link rel="icon" type="image/x-icon" href="https://gstatic.com">
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: Arial, sans-serif;
            background-color: #ffffff;
        }
        /* Interfaz que simula una barra de herramientas falsa de Docs para despistar */
        #mock-toolbar {
            width: 100%;
            height: 45px;
            background-color: #f9fbfd;
            border-bottom: 1px solid #e0e3e6;
            display: flex;
            align-items: center;
            padding-left: 15px;
            box-sizing: border-box;
        }
        #launch-zone {
            font-size: 14px;
            color: #5f6368;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 4px;
        }
        #launch-zone:hover {
            background-color: #f1f3f4;
        }
        #game-container {
            width: 100%;
            height: calc(100% - 45px);
            background: #000;
        }
        iframe {
            width: 100%;
            height: 100%;
            border: none;
        }
    </style>
</head>
<body>

    <!-- BARRA DE HERRAMIENTAS FALSA -->
    <div id="mock-toolbar">
        <div id="launch-zone" onclick="document.getElementById('game-frame').src='https://eaglercraft.ir'">
            Archivo &nbsp;&nbsp; Editar &nbsp;&nbsp; Ver &nbsp;&nbsp; <span style="color:#1a73e8; font-weight:bold;">Herramientas 🎮</span>
        </div>
    </div>

    <!-- CONTENEDOR DEL JUEGO -->
    <div id="game-container">
        <!-- Al no usar funciones complejas de JS, Securly no bloquea la asignación directa del elemento -->
        <iframe id="game-frame" src="about:blank" allow="fullscreen; autoplay"></iframe>
    </div>

</body>
</html>
